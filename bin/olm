#!/usr/bin/env bash
# olm - Interactive CLI Assistant

die() { echo "ERROR: $*" >&2; exit 1; }

# ============================================================
# Paths & Config
# ============================================================
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

CFG_DIR="${OLM_CFG_DIR:-$HOME/.config/olm}"
CFG_FILE="${OLM_CONFIG:-$CFG_DIR/config.env}"
[ -f "$CFG_FILE" ] && source "$CFG_FILE" || true

DATA_DIR="${OLM_DATA_DIR:-$HOME/.local/share/olm}"
LOG_DIR="${OLM_LOG_DIR:-$DATA_DIR}"
LOG_FILE="${OLM_LOG_FILE:-$LOG_DIR/olm.log}"
HIST_FILE="${OLM_HIST_FILE:-$LOG_DIR/olm_history.tsv}"
RAG_DB="${OLM_RAG_DB:-$REPO_ROOT/rag2/rag/rag.db}"
mkdir -p "$LOG_DIR"
touch "$HIST_FILE" 2>/dev/null || true

OLM_LANG="${OLM_LANG:-jp}"
OLM_USE_RAG="${OLM_USE_RAG:-1}"
DEFAULT_MODEL="${OLM_MODEL_LGT:-phi3:3.8b-mini-4k-instruct-q4_k_m}"

# ============================================================
# RAG functions
# ============================================================
esc_sql(){ printf "%s" "$1" | sed "s/'/''/g"; }
rag_save() {
  [ "$OLM_USE_RAG" = "1" ] && [ -f "$RAG_DB" ] || return 0
  local status="$1" cmd="$2" output="$3"
  local cmd_sig; cmd_sig="$(printf "%s" "$cmd" | sed -E 's/[0-9]+/<N>/g' | cut -c1-160)"
  local err_sig=""; [ "$status" -ne 0 ] && err_sig="$(printf "%s" "$output" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g' | cut -c1-200)"
  local fingerprint; fingerprint="$(printf "%s|%s" "$cmd_sig" "$err_sig" | sha1sum | awk '{print $1}')"
  sqlite3 "$RAG_DB" <<SQL 2>/dev/null || true
INSERT INTO cases(status,fingerprint,body,cmd,rc,cwd,err_sig,cmd_sig,updated_at)
VALUES('$( [ "$status" -eq 0 ] && echo ok || echo failed )','$fingerprint','$(esc_sql "$output")','$(esc_sql "$cmd")',$status,'$(esc_sql "$(pwd)")','$(esc_sql "$err_sig")','$(esc_sql "$cmd_sig")',datetime('now'))
ON CONFLICT(fingerprint) DO UPDATE SET updated_at=datetime('now');
SQL
}

# ============================================================
# LLM Core
# ============================================================
ask_llm() {
  local task_instruction="$1"
  local context_cmd="$2"
  local context_out="$3"
  local context_status="$4"
  local sys_msg="あなたは優秀なエンジニアです。必ず日本語で簡潔に回答してください。英語のメタ発言や思考プロセスは出力しないでください。"
  local full_prompt="[SYSTEM]: ${sys_msg}\n[TASK]: ${task_instruction}\n[COMMAND]: ${context_cmd}\n[STATUS]: ${context_status}\n[OUTPUT]:\n$(printf "%s" "$context_out" | head -c 1000)"
  printf "Thinking... " >&2
  local res; res="$(printf "%s" "$full_prompt" | ollama run "$DEFAULT_MODEL" 2>/dev/null | grep -vE "^Thinking|^We need to|^They likely|^The format")"
  printf "\r           \r" >&2
  printf "%s\n" "$res" | sed '/^[[:space:]]*$/d'
}

# ============================================================
# Actions
# ============================================================
do_summary() { ask_llm "実行結果を1行で日本語要約してください。" "$1" "$2" "$3"; }
do_detail() { ask_llm "実行内容と結果を日本語で詳しく解説してください。" "$1" "$2" "$3"; }
do_diagnose() { ask_llm "エラー解決のための確認コマンドを $ で始まる形式で提示してください。" "$1" "$2" "$3"; }

do_rag_fix() {
  [ -f "$RAG_DB" ] || return
  local base_cmd; base_cmd="$(printf "%s" "$1" | awk '{print $1}')"
  local suggestions=($(sqlite3 -noheader "$RAG_DB" "SELECT DISTINCT CASE WHEN INSTR(cmd, ' ') > 0 THEN SUBSTR(cmd, 1, INSTR(cmd, ' ') - 1) ELSE cmd END as c FROM cases WHERE status='ok' AND c LIKE '$(printf "%.1s" "$base_cmd")%' AND c != '$(esc_sql "$base_cmd")' LIMIT 5;" 2>/dev/null))
  if [ "${#suggestions[@]}" -eq 0 ]; then echo "履歴に候補はありません。"; return; fi
  echo "---- Suggestions (RAG履歴) ----"
  for i in "${!suggestions[@]}"; do printf " [%d] %s\n" "$((i+1))" "${suggestions[$i]}"; done
  printf "\n選択 (Enterで戻る): "; read -r choice < /dev/tty
  if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -le "${#suggestions[@]}" ]; then
    local selected="${suggestions[$((choice-1))]}"; local args="$(printf "%s" "$1" | awk '{$1=""; print $0}' | sed 's/^ //')"
    echo "Executing: $selected $args"; exec bash -lc "$selected $args"
  fi
}

do_ai_fix() {
  echo "AIが修正案と実行結果の予測を生成しています..."
  local res; res="$(ask_llm "このエラーを修正するための正しいコマンドを1つ提示してください。また、そのコマンドが何を行うか、実行することでどのような結果が期待できるかを日本語で説明してください。形式は必ず『修正コマンド: $ (コマンド)』を含めてください。" "$1" "$2" "$3")"
  
  if [ -n "$res" ]; then
    echo -e "\n==== AIの提案 ===="
    printf "%s\n" "$res"
    
    local suggested_cmd; suggested_cmd="$(printf "%s" "$res" | grep '修正コマンド: \$ ' | head -n 1 | sed 's/.*修正コマンド: \$ //')"
    [ -z "$suggested_cmd" ] && suggested_cmd="$(printf "%s" "$res" | grep '^\$ ' | head -n 1 | sed 's/^\$ //')"

    if [ -n "$suggested_cmd" ]; then
      echo -e "==================\n"
      printf "このコマンド [ %s ] を実行しますか？ (y/N): " "$suggested_cmd"; read -r confirm < /dev/tty
      if [[ "$confirm" =~ ^[yY]$ ]]; then
        echo "Executing..."
        exec bash -lc "$suggested_cmd"
      fi
    fi
  else
    echo "AIから有効な修正案が得られませんでした。"
  fi
}

do_custom_ask() {
  printf "\nAIへの質問を入力してください: "; read -r user_q < /dev/tty
  [ -z "$user_q" ] && return
  ask_llm "$user_q" "$1" "$2" "$3"
}

# ============================================================
# Main Loop
# ============================================================
[ "$#" -gt 0 ] || die 'Usage: olm "command"'
cmd="$*"; tmp_out="$(mktemp)"; bash -lc "$cmd" >"$tmp_out" 2>&1; status=$?
cat "$tmp_out"; output="$(cat "$tmp_out")"; rm -f "$tmp_out"
rag_save "$status" "$cmd" "$output"

while true; do
  echo -e "\n---- [olm] メニュー (Lang: $OLM_LANG | Model: $DEFAULT_MODEL) ----"
  echo " [1] 要約 (何が起きたか)"
  echo " [2] 解説 (詳細な内容)"
  echo " [3] 対策 (次の確認コマンド)"
  echo " [4] 修正 (RAG履歴から)"
  echo " [5] 修正 (AI/Ollamaから)"
  echo " [6] 質問 (自由入力)"
  echo " [0] 終了"
  printf ">> "; read -r opt < /dev/tty
  case "$opt" in
    1) do_summary "$cmd" "$output" "$status" ;;
    2) do_detail "$cmd" "$output" "$status" ;;
    3) do_diagnose "$cmd" "$output" "$status" ;;
    4) do_rag_fix "$cmd" "$output" "$status" ;;
    5) do_ai_fix "$cmd" "$output" "$status" ;;
    6) do_custom_ask "$cmd" "$output" "$status" ;;
    0|"") break ;;
    *) echo "無効な選択です。" ;;
  esac
done
exit "$status"
